# Copy this file to ".env" and paste your key.
# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: image/screen understanding. Put the real key in .env (git-ignored),
# never in this tracked file.
GEMINI_API_KEY=

# Optional: read-only mailbox check (an APP password, not your login password).
# Leave these blank to connect from the sidebar instead.
JARVIS_EMAIL_USER=
JARVIS_EMAIL_PASSWORD=
JARVIS_EMAIL_HOST=
JARVIS_EMAIL_PORT=

# Optional: where follow-ups are saved (default: ~/.jarvis)
# JARVIS_HOME=

# Optional: official Meta WhatsApp Cloud API (a Business number).
# Token/secret: paste them here, or enter them in the sidebar panel.
# JARVIS_WA_TOKEN=
# JARVIS_WA_PHONE_ID=
# JARVIS_WA_WABA_ID=
# JARVIS_WA_APP_SECRET=
# JARVIS_WA_VERIFY_TOKEN=jarvis-whatsapp
# JARVIS_WA_API_VERSION=v25.0
# Public HTTPS address the WhatsApp webhook is reachable on (behind a tunnel or
# when hosted). Without it JARVIS can still send, just not receive.
# JARVIS_PUBLIC_URL=
